# PostgreSQL connection string (Supabase → Project Settings → Database → Connection string → URI)
# For Supabase, prefer the Session pooler URI if the direct host is IPv6-only.
# The pooler username looks like postgres.<project-ref> and the port is 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employees

# Set to true when your provider requires SSL (Supabase does)
DB_SSL=true

# API port
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Super admin created (or refreshed) on every server start
SUPER_ADMIN_EMAIL=default@example.com
SUPER_ADMIN_PASSWORD=kaam-chor-majdoor

# Signing secret for login tokens — use a long random value in production
JWT_SECRET=dev-only-change-me-in-production

# Initial password for employee accounts created without one
DEFAULT_EMPLOYEE_PASSWORD=Majdoor-hu-mai
