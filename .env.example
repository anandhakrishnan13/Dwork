# One shared environment file for the backend and frontend.
# Copy this file to .env in the repository root:
#
#   cp .env.example .env
#
# Both apps read it: the API loads it from backend/src/config.ts, and Next.js
# loads it from frontend/next.config.ts. Shell environment variables still win.

# --- Backend ---------------------------------------------------------------

# PostgreSQL connection string. For Supabase, use the Session pooler URI when
# the direct host is IPv6-only. The pooler username looks like
# postgres.<project-ref> and the port is 5432. For Vercel Functions, use the
# transaction pooler on port 6543 instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employees

# Set to true for Supabase/hosted Postgres, false for local Postgres.
DB_SSL=false

PORT=4000

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Super admin created or refreshed on every API start.
SUPER_ADMIN_EMAIL=default@example.com
SUPER_ADMIN_PASSWORD=kaam-chor-majdoor

# Signing secret for login tokens. Use a long random value in production.
JWT_SECRET=dev-only-change-me-in-production

# Initial password for employee accounts created without one.
DEFAULT_EMPLOYEE_PASSWORD=Majdoor-hu-mai

# --- Frontend --------------------------------------------------------------

# Public API base URL. This value is inlined into the browser bundle at build time.
# Local development: http://localhost:4000
# Vercel Services:   /api
NEXT_PUBLIC_API_URL=http://localhost:4000
